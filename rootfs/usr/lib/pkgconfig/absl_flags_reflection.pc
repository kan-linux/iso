prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flags_reflection
Description: Abseil flags_reflection library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_fast_type_id = 20260817, absl_flags_commandlineflag = 20260817, absl_flags_private_handle_accessor = 20260817, absl_flags_config = 20260817, absl_strings = 20260817, absl_synchronization = 20260817, absl_flat_hash_map = 20260817, absl_no_destructor = 20260817
Libs: -L${libdir}  -labsl_flags_reflection 
Cflags: -I${includedir} -DNOMINMAX
