prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_time
Description: Abseil time library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_civil_time = 20260817, absl_core_headers = 20260817, absl_int128 = 20260817, absl_raw_logging_internal = 20260817, absl_strings = 20260817, absl_time_zone = 20260817
Libs: -L${libdir}  -labsl_time 
Cflags: -I${includedir} -DNOMINMAX
