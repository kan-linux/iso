prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_random_internal_seed_material
Description: Abseil random_internal_seed_material library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_optional = 20260817, absl_random_internal_fast_uniform_bits = 20260817, absl_raw_logging_internal = 20260817, absl_span = 20260817, absl_strings = 20260817
Libs: -L${libdir}  -labsl_random_internal_seed_material 
Cflags: -I${includedir} -DNOMINMAX
