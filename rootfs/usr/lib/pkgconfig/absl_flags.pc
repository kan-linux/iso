prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flags
Description: Abseil flags library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_flags_commandlineflag = 20260817, absl_flags_config = 20260817, absl_flags_internal = 20260817, absl_flags_reflection = 20260817, absl_core_headers = 20260817, absl_nullability = 20260817, absl_strings = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
