prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_hash_function_defaults
Description: Abseil hash_function_defaults library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_container_common = 20260817, absl_cord = 20260817, absl_hash = 20260817, absl_strings = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
