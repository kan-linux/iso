prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_structured
Description: Abseil log_internal_structured library
URL: https://abseil.io/
Version: 20260817
Requires: absl_any_invocable = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_log_internal_message = 20260817, absl_log_internal_structured_proto = 20260817, absl_strings = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
