prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flags_parse
Description: Abseil flags_parse library
URL: https://abseil.io/
Version: 20260817
Requires: absl_algorithm_container = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_flags_config = 20260817, absl_flags = 20260817, absl_flags_commandlineflag = 20260817, absl_flags_commandlineflag_internal = 20260817, absl_flags_internal = 20260817, absl_flags_private_handle_accessor = 20260817, absl_flags_program_name = 20260817, absl_flags_reflection = 20260817, absl_flags_usage = 20260817, absl_no_destructor = 20260817, absl_strings = 20260817, absl_synchronization = 20260817
Libs: -L${libdir}  -labsl_flags_parse 
Cflags: -I${includedir} -DNOMINMAX
