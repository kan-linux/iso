prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_structured_proto
Description: Abseil log_internal_structured_proto library
URL: https://abseil.io/
Version: 20260817
Requires: absl_log_internal_proto = 20260817, absl_config = 20260817, absl_span = 20260817, absl_strings = 20260817, absl_variant = 20260817
Libs: -L${libdir}  -labsl_log_internal_structured_proto 
Cflags: -I${includedir} -DNOMINMAX
