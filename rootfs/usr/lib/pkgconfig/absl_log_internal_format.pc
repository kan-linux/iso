prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_format
Description: Abseil log_internal_format library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_log_internal_append_truncated = 20260817, absl_log_internal_config = 20260817, absl_log_internal_globals = 20260817, absl_log_severity = 20260817, absl_strings = 20260817, absl_str_format = 20260817, absl_time = 20260817, absl_span = 20260817
Libs: -L${libdir}  -labsl_log_internal_format 
Cflags: -I${includedir} -DNOMINMAX
