prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flags_commandlineflag
Description: Abseil flags_commandlineflag library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_fast_type_id = 20260817, absl_flags_commandlineflag_internal = 20260817, absl_nullability = 20260817, absl_optional = 20260817, absl_strings = 20260817
Libs: -L${libdir}  -labsl_flags_commandlineflag 
Cflags: -I${includedir} -DNOMINMAX
