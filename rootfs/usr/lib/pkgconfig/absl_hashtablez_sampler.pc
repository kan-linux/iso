prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_hashtablez_sampler
Description: Abseil hashtablez_sampler library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_config = 20260817, absl_exponential_biased = 20260817, absl_no_destructor = 20260817, absl_raw_logging_internal = 20260817, absl_sample_recorder = 20260817, absl_synchronization = 20260817, absl_time = 20260817
Libs: -L${libdir}  -labsl_hashtablez_sampler 
Cflags: -I${includedir} -DNOMINMAX
