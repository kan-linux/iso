prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_random_bit_gen_ref
Description: Abseil random_bit_gen_ref library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_random_internal_fast_uniform_bits = 20260817, absl_type_traits = 20260817, absl_random_mocking_access = 20260817, absl_random_internal_traits = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
