prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_str_format_internal
Description: Abseil str_format_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_bits = 20260817, absl_strings = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_fixed_array = 20260817, absl_inlined_vector = 20260817, absl_numeric_representation = 20260817, absl_type_traits = 20260817, absl_utility = 20260817, absl_int128 = 20260817, absl_span = 20260817, absl_strings_internal = 20260817
Libs: -L${libdir}  -labsl_str_format_internal 
Cflags: -I${includedir} -DNOMINMAX
