prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flags_usage_internal
Description: Abseil flags_usage_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_flags_config = 20260817, absl_flags = 20260817, absl_flags_commandlineflag = 20260817, absl_flags_internal = 20260817, absl_flags_path_util = 20260817, absl_flags_private_handle_accessor = 20260817, absl_flags_program_name = 20260817, absl_flags_reflection = 20260817, absl_strings = 20260817, absl_synchronization = 20260817
Libs: -L${libdir}  -labsl_flags_usage_internal 
Cflags: -I${includedir} -DNOMINMAX
