prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_container_memory
Description: Abseil container_memory library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_hash = 20260817, absl_memory = 20260817, absl_type_traits = 20260817, absl_utility = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
