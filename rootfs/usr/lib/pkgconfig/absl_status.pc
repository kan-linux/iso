prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_status
Description: Abseil status library
URL: https://abseil.io/
Version: 20260817
Requires: absl_atomic_hook = 20260817, absl_config = 20260817, absl_cord = 20260817, absl_core_headers = 20260817, absl_function_ref = 20260817, absl_inlined_vector = 20260817, absl_internal_optional_ref = 20260817, absl_leak_check = 20260817, absl_memory = 20260817, absl_no_destructor = 20260817, absl_nullability = 20260817, absl_optional = 20260817, absl_raw_logging_internal = 20260817, absl_source_location = 20260817, absl_span = 20260817, absl_stacktrace = 20260817, absl_str_format = 20260817, absl_strerror = 20260817, absl_strings = 20260817, absl_symbolize = 20260817
Libs: -L${libdir}  -labsl_status 
Cflags: -I${includedir} -DNOMINMAX
