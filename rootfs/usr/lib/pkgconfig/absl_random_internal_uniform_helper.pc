prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_random_internal_uniform_helper
Description: Abseil random_internal_uniform_helper library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_random_internal_traits = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
