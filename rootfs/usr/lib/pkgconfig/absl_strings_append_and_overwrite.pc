prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_strings_append_and_overwrite
Description: Abseil strings_append_and_overwrite library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_hardening = 20260817, absl_strings_resize_and_overwrite = 20260817, absl_throw_delegate = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
