prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_failure_signal_handler
Description: Abseil failure_signal_handler library
URL: https://abseil.io/
Version: 20260817
Requires: absl_examine_stack = 20260817, absl_stacktrace = 20260817, absl_base = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_raw_logging_internal = 20260817
Libs: -L${libdir}  -labsl_failure_signal_handler 
Cflags: -I${includedir} -DNOMINMAX
