prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_cord
Description: Abseil cord library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_config = 20260817, absl_cord_internal = 20260817, absl_cordz_functions = 20260817, absl_cordz_info = 20260817, absl_cordz_update_scope = 20260817, absl_cordz_update_tracker = 20260817, absl_core_headers = 20260817, absl_crc32c = 20260817, absl_crc_cord_state = 20260817, absl_endian = 20260817, absl_function_ref = 20260817, absl_hardening = 20260817, absl_inlined_vector = 20260817, absl_nullability = 20260817, absl_optional = 20260817, absl_raw_logging_internal = 20260817, absl_span = 20260817, absl_strings = 20260817, absl_strings_append_and_overwrite = 20260817, absl_strings_resize_and_overwrite = 20260817, absl_type_traits = 20260817, absl_weakly_mixed_integer = 20260817
Libs: -L${libdir}  -labsl_cord 
Cflags: -I${includedir} -DNOMINMAX
