prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_poison
Description: Abseil poison library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_malloc_internal = 20260817
Libs: -L${libdir}  -labsl_poison 
Cflags: -I${includedir} -DNOMINMAX
