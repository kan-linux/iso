prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_strip
Description: Abseil log_internal_strip library
URL: https://abseil.io/
Version: 20260817
Requires: absl_core_headers = 20260817, absl_log_internal_message = 20260817, absl_log_internal_nullstream = 20260817, absl_log_severity = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
