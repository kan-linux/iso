prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_spinlock_wait
Description: Abseil spinlock_wait library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base_internal = 20260817, absl_core_headers = 20260817, absl_errno_saver = 20260817
Libs: -L${libdir}  -labsl_spinlock_wait 
Cflags: -I${includedir} -DNOMINMAX
