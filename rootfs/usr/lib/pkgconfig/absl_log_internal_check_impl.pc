prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_check_impl
Description: Abseil log_internal_check_impl library
URL: https://abseil.io/
Version: 20260817
Requires: absl_core_headers = 20260817, absl_log_internal_check_op = 20260817, absl_log_internal_conditions = 20260817, absl_log_internal_strip = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
