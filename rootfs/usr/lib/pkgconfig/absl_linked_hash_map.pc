prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_linked_hash_map
Description: Abseil linked_hash_map library
URL: https://abseil.io/
Version: 20260817
Requires: absl_container_common = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_flat_hash_set = 20260817, absl_throw_delegate = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
