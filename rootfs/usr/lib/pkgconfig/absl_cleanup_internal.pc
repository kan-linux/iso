prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_cleanup_internal
Description: Abseil cleanup_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_core_headers = 20260817, absl_hardening = 20260817, absl_utility = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
