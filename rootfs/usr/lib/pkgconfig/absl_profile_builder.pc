prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_profile_builder
Description: Abseil profile_builder library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_raw_logging_internal = 20260817, absl_flat_hash_map = 20260817, absl_btree = 20260817, absl_strings = 20260817, absl_str_format = 20260817, absl_span = 20260817
Libs: -L${libdir}  -labsl_profile_builder 
Cflags: -I${includedir} -DNOMINMAX
