prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_algorithm_container
Description: Abseil algorithm_container library
URL: https://abseil.io/
Version: 20260817
Requires: absl_algorithm = 20260817, absl_hardening = 20260817, absl_config = 20260817, absl_iterator_traits_internal = 20260817, absl_core_headers = 20260817, absl_meta = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
