prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_hash
Description: Abseil hash library
URL: https://abseil.io/
Version: 20260817
Requires: absl_bits = 20260817, absl_city = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_endian = 20260817, absl_fixed_array = 20260817, absl_function_ref = 20260817, absl_meta = 20260817, absl_int128 = 20260817, absl_strings = 20260817, absl_optional = 20260817, absl_variant = 20260817, absl_utility = 20260817, absl_weakly_mixed_integer = 20260817
Libs: -L${libdir}  -labsl_hash 
Cflags: -I${includedir} -DNOMINMAX
