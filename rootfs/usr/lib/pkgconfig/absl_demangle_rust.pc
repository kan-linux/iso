prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_demangle_rust
Description: Abseil demangle_rust library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_decode_rust_punycode = 20260817
Libs: -L${libdir}  -labsl_demangle_rust 
Cflags: -I${includedir} -DNOMINMAX
