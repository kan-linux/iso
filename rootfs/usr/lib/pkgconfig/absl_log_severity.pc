prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_severity
Description: Abseil log_severity library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817
Libs: -L${libdir}  -labsl_log_severity 
Cflags: -I${includedir} -DNOMINMAX
