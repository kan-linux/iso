prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_hardening
Description: Abseil hardening library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817
Libs: -L${libdir}  -labsl_hardening 
Cflags: -I${includedir} -DNOMINMAX
