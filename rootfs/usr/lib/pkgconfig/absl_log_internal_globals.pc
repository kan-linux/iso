prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_globals
Description: Abseil log_internal_globals library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_log_severity = 20260817, absl_raw_logging_internal = 20260817, absl_strings = 20260817, absl_time = 20260817
Libs: -L${libdir}  -labsl_log_internal_globals 
Cflags: -I${includedir} -DNOMINMAX
