prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_internal_log_impl
Description: Abseil log_internal_log_impl library
URL: https://abseil.io/
Version: 20260817
Requires: absl_log_internal_conditions = 20260817, absl_log_internal_message = 20260817, absl_log_internal_strip = 20260817, absl_absl_vlog_is_on = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
