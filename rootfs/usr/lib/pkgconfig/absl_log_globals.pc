prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_globals
Description: Abseil log_globals library
URL: https://abseil.io/
Version: 20260817
Requires: absl_atomic_hook = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_hash = 20260817, absl_log_severity = 20260817, absl_raw_logging_internal = 20260817, absl_strings = 20260817, absl_vlog_config_internal = 20260817
Libs: -L${libdir}  -labsl_log_globals 
Cflags: -I${includedir} -DNOMINMAX
