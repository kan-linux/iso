prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_debugging_internal
Description: Abseil debugging_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_core_headers = 20260817, absl_config = 20260817, absl_dynamic_annotations = 20260817, absl_errno_saver = 20260817, absl_raw_logging_internal = 20260817
Libs: -L${libdir}  -labsl_debugging_internal 
Cflags: -I${includedir} -DNOMINMAX
