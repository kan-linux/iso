prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_layout
Description: Abseil layout library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_debugging_internal = 20260817, absl_meta = 20260817, absl_strings = 20260817, absl_span = 20260817, absl_utility = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
