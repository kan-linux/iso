prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_symbolize
Description: Abseil symbolize library
URL: https://abseil.io/
Version: 20260817
Requires: absl_debugging_internal = 20260817, absl_demangle_internal = 20260817, absl_base = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_dynamic_annotations = 20260817, absl_malloc_internal = 20260817, absl_raw_logging_internal = 20260817, absl_strings = 20260817
Libs: -L${libdir}  -labsl_symbolize 
Cflags: -I${includedir} -DNOMINMAX
