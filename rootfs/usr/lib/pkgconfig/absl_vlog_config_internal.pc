prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_vlog_config_internal
Description: Abseil vlog_config_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_log_internal_fnmatch = 20260817, absl_memory = 20260817, absl_no_destructor = 20260817, absl_nullability = 20260817, absl_strings = 20260817, absl_synchronization = 20260817
Libs: -L${libdir}  -labsl_vlog_config_internal 
Cflags: -I${includedir} -DNOMINMAX
