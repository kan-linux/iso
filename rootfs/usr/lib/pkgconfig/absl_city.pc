prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_city
Description: Abseil city library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_bits = 20260817, absl_endian = 20260817
Libs: -L${libdir}  -labsl_city 
Cflags: -I${includedir} -DNOMINMAX
