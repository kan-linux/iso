prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: Pango Xft
Description: Xft font support for Pango
Version: 1.56.1
Requires: pangoft2, xft >=  2.0.0
Requires.private: pango, glib-2.0 >=  2.80, gobject-2.0 >=  2.80, gio-2.0 >=  2.80, fribidi >=  1.0.6, harfbuzz >=  8.4.0, fontconfig >=  2.15.0, freetype2, xrender, cairo >=  1.18.0
Libs: -L${libdir} -lpangoxft-1.0
Libs.private: -lm
Cflags: -I${includedir}/pango-1.0
