prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_str_format
Description: Abseil str_format library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_nullability = 20260817, absl_span = 20260817, absl_str_format_internal = 20260817, absl_string_view = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
