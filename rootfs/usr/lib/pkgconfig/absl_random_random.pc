prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_random_random
Description: Abseil random_random library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_random_distributions = 20260817, absl_random_internal_nonsecure_base = 20260817, absl_random_internal_pcg_engine = 20260817, absl_random_internal_randen_engine = 20260817, absl_random_seed_sequences = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
