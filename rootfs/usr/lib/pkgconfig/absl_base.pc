prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_base
Description: Abseil base library
URL: https://abseil.io/
Version: 20260817
Requires: absl_atomic_hook = 20260817, absl_base_internal = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_dynamic_annotations = 20260817, absl_log_severity = 20260817, absl_nullability = 20260817, absl_raw_logging_internal = 20260817, absl_spinlock_wait = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  -labsl_base -lrt 
Cflags: -I${includedir} -DNOMINMAX
