prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_random_internal_pcg_engine
Description: Abseil random_internal_pcg_engine library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_int128 = 20260817, absl_random_internal_fastmath = 20260817, absl_random_internal_iostream_state_saver = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
