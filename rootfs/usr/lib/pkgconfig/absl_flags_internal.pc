prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flags_internal
Description: Abseil flags_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_config = 20260817, absl_fast_type_id = 20260817, absl_flags_commandlineflag = 20260817, absl_flags_commandlineflag_internal = 20260817, absl_flags_config = 20260817, absl_flags_marshalling = 20260817, absl_no_destructor = 20260817, absl_synchronization = 20260817, absl_meta = 20260817, absl_utility = 20260817
Libs: -L${libdir}  -labsl_flags_internal 
Cflags: -I${includedir} -DNOMINMAX
