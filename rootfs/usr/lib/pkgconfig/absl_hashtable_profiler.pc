prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_hashtable_profiler
Description: Abseil hashtable_profiler library
URL: https://abseil.io/
Version: 20260817
Requires: absl_profile_builder = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_strings = 20260817, absl_span = 20260817, absl_hashtablez_sampler = 20260817
Libs: -L${libdir}  -labsl_hashtable_profiler 
Cflags: -I${includedir} -DNOMINMAX
