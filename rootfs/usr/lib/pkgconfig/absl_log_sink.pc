prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_sink
Description: Abseil log_sink library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_log_entry = 20260817
Libs: -L${libdir}  -labsl_log_sink 
Cflags: -I${includedir} -DNOMINMAX
