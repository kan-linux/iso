prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_inlined_vector_internal
Description: Abseil inlined_vector_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base_internal = 20260817, absl_compressed_tuple = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_hardening = 20260817, absl_memory = 20260817, absl_span = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
