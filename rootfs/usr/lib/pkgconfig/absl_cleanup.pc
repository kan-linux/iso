prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_cleanup
Description: Abseil cleanup library
URL: https://abseil.io/
Version: 20260817
Requires: absl_cleanup_internal = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_hardening = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
