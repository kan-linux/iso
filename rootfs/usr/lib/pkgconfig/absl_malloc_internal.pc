prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_malloc_internal
Description: Abseil malloc_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_base_internal = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_dynamic_annotations = 20260817, absl_raw_logging_internal = 20260817
Libs: -L${libdir}  -labsl_malloc_internal 
Cflags: -I${includedir} -DNOMINMAX
