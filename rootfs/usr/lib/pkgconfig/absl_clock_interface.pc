prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_clock_interface
Description: Abseil clock_interface library
URL: https://abseil.io/
Version: 20260817
Requires: absl_time = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_no_destructor = 20260817, absl_nullability = 20260817, absl_raw_logging_internal = 20260817, absl_synchronization = 20260817
Libs: -L${libdir}  -labsl_clock_interface 
Cflags: -I${includedir} -DNOMINMAX
