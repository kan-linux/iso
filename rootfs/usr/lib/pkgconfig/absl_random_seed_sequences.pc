prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_random_seed_sequences
Description: Abseil random_seed_sequences library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_inlined_vector = 20260817, absl_nullability = 20260817, absl_random_internal_entropy_pool = 20260817, absl_random_internal_salted_seed_seq = 20260817, absl_random_internal_seed_material = 20260817, absl_random_seed_gen_exception = 20260817, absl_span = 20260817, absl_string_view = 20260817
Libs: -L${libdir}  -labsl_random_seed_sequences 
Cflags: -I${includedir} -DNOMINMAX
