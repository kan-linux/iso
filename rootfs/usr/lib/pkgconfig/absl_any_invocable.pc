prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_any_invocable
Description: Abseil any_invocable library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_type_traits = 20260817, absl_utility = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
