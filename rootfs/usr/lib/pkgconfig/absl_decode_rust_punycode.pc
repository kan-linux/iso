prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_decode_rust_punycode
Description: Abseil decode_rust_punycode library
URL: https://abseil.io/
Version: 20260817
Requires: absl_bounded_utf8_length_sequence = 20260817, absl_config = 20260817, absl_nullability = 20260817, absl_utf8_for_code_point = 20260817
Libs: -L${libdir}  -labsl_decode_rust_punycode 
Cflags: -I${includedir} -DNOMINMAX
