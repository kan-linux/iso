prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_crc_internal
Description: Abseil crc_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base_cpu_detect = 20260817, absl_bits = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_endian = 20260817, absl_memory = 20260817, absl_prefetch = 20260817, absl_raw_logging_internal = 20260817
Libs: -L${libdir}  -labsl_crc_internal 
Cflags: -I${includedir} -DNOMINMAX
