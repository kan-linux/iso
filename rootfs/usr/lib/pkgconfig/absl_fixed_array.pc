prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_fixed_array
Description: Abseil fixed_array library
URL: https://abseil.io/
Version: 20260817
Requires: absl_compressed_tuple = 20260817, absl_algorithm = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_dynamic_annotations = 20260817, absl_hardening = 20260817, absl_iterator_traits_internal = 20260817, absl_throw_delegate = 20260817, absl_memory = 20260817, absl_weakly_mixed_integer = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
