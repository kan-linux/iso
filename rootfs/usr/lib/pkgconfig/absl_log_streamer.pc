prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_log_streamer
Description: Abseil log_streamer library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_absl_log = 20260817, absl_log_severity = 20260817, absl_optional = 20260817, absl_source_location = 20260817, absl_strings = 20260817, absl_strings_internal = 20260817, absl_utility = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
