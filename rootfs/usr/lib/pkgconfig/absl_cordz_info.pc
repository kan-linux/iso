prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_cordz_info
Description: Abseil cordz_info library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_config = 20260817, absl_cord_internal = 20260817, absl_cordz_functions = 20260817, absl_cordz_handle = 20260817, absl_cordz_statistics = 20260817, absl_cordz_update_tracker = 20260817, absl_core_headers = 20260817, absl_no_destructor = 20260817, absl_inlined_vector = 20260817, absl_span = 20260817, absl_raw_logging_internal = 20260817, absl_stacktrace = 20260817, absl_synchronization = 20260817, absl_time = 20260817
Libs: -L${libdir}  -labsl_cordz_info 
Cflags: -I${includedir} -DNOMINMAX
