prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_span
Description: Abseil span library
URL: https://abseil.io/
Version: 20260817
Requires: absl_algorithm = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_hardening = 20260817, absl_nullability = 20260817, absl_throw_delegate = 20260817, absl_type_traits = 20260817, absl_weakly_mixed_integer = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
