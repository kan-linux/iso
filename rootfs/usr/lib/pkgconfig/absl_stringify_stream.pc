prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_stringify_stream
Description: Abseil stringify_stream library
URL: https://abseil.io/
Version: 20260817
Requires: absl_string_view = 20260817, absl_config = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
