prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_generic_printer_internal
Description: Abseil generic_printer_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_strings = 20260817, absl_str_format = 20260817, absl_log_internal_container = 20260817, absl_requires_internal = 20260817
Libs: -L${libdir}  -labsl_generic_printer_internal 
Cflags: -I${includedir} -DNOMINMAX
