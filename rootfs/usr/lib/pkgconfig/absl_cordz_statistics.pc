prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_cordz_statistics
Description: Abseil cordz_statistics library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_core_headers = 20260817, absl_cordz_update_tracker = 20260817, absl_synchronization = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
