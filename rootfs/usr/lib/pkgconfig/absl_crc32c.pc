prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_crc32c
Description: Abseil crc32c library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base_cpu_detect = 20260817, absl_crc_internal = 20260817, absl_non_temporal_memcpy = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_endian = 20260817, absl_prefetch = 20260817, absl_str_format = 20260817, absl_strings = 20260817
Libs: -L${libdir}  -labsl_crc32c 
Cflags: -I${includedir} -DNOMINMAX
