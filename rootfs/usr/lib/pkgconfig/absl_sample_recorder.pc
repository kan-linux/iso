prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_sample_recorder
Description: Abseil sample_recorder library
URL: https://abseil.io/
Version: 20260817
Requires: absl_base = 20260817, absl_synchronization = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
