prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_cord_internal
Description: Abseil cord_internal library
URL: https://abseil.io/
Version: 20260817
Requires: absl_compressed_tuple = 20260817, absl_config = 20260817, absl_container_memory = 20260817, absl_compare = 20260817, absl_core_headers = 20260817, absl_crc_cord_state = 20260817, absl_endian = 20260817, absl_inlined_vector = 20260817, absl_layout = 20260817, absl_raw_logging_internal = 20260817, absl_strings = 20260817, absl_throw_delegate = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  -labsl_cord_internal 
Cflags: -I${includedir} -DNOMINMAX
