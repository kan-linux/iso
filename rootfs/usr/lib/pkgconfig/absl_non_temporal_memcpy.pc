prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_non_temporal_memcpy
Description: Abseil non_temporal_memcpy library
URL: https://abseil.io/
Version: 20260817
Requires: absl_non_temporal_arm_intrinsics = 20260817, absl_config = 20260817, absl_core_headers = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
