prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: libavformat
Description: FFmpeg container format library
Version: 63.1.102
Requires: 
Requires.private: libavcodec >= 63.1.102, libswresample >= 7.1.102, libavutil >= 61.1.102
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm
Cflags: -I${includedir}
