prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_flat_hash_set
Description: Abseil flat_hash_set library
URL: https://abseil.io/
Version: 20260817
Requires: absl_container_memory = 20260817, absl_hash_container_defaults = 20260817, absl_raw_hash_set = 20260817, absl_algorithm_container = 20260817, absl_core_headers = 20260817, absl_memory = 20260817, absl_type_traits = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
