prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_raw_hash_map
Description: Abseil raw_hash_map library
URL: https://abseil.io/
Version: 20260817
Requires: absl_config = 20260817, absl_common_policy_traits = 20260817, absl_container_memory = 20260817, absl_core_headers = 20260817, absl_raw_hash_set = 20260817, absl_type_traits = 20260817, absl_throw_delegate = 20260817
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
