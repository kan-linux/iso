prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_int128
Description: Abseil int128 library
URL: https://abseil.io/
Version: 20260817
Requires: absl_compare = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_bits = 20260817
Libs: -L${libdir}  -labsl_int128 
Cflags: -I${includedir} -DNOMINMAX
