prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include

Name: absl_examine_stack
Description: Abseil examine_stack library
URL: https://abseil.io/
Version: 20260817
Requires: absl_stacktrace = 20260817, absl_symbolize = 20260817, absl_config = 20260817, absl_core_headers = 20260817, absl_raw_logging_internal = 20260817
Libs: -L${libdir}  -labsl_examine_stack 
Cflags: -I${includedir} -DNOMINMAX
